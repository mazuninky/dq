/target/
**/target/
**/*.rs.bk
Cargo.lock.bak

# OS / editor cruft
.DS_Store
*.swp
*.swo
*~

# Editor configs that shouldn't be committed
.idea/
.vscode/

# Distribution artifacts
/dist/

# Node (skill-build tooling, mdbook output)
/node_modules/

.claude/settings.local.json
.worktreeinclude

# Claude Code worktrees
.claude/worktrees/

# /local-fix per-pass artefacts (review findings + thread payloads)
.claude/local-fix-*.jsonl
.claude/local-fix-*.json

# Skill eval runner — workspace + staging dirs are per-run artefacts, not source.
**/*-workspace/
/plugins/

# Locally built dq-plugin integration-test fixtures (see crates/dq-plugin/tests/fixtures/README.md)
crates/dq-plugin/tests/fixtures/*.wasm

# Written by `cargo component build`; the example generates its bindings with `wit_bindgen::generate!`
examples/plugin-rust/src/bindings.rs
