{
  "name": "dq",
  "description": "Agent-friendly CLI for structured data (YAML/JSON/TOML/HCL/INI/.env/CSV/XML/Markdown frontmatter/Dockerfile) plus a lint + autofix engine. Use for queries, in-place edits with round-trip preservation, format conversion, RFC 6902/7396 patches, semantic diff, and CI lint with SARIF/JUnit/TAP output.",
  "version": "2026.20.1",
  "triggers": [
    "yaml query",
    "yaml lint",
    "yaml autofix",
    "json patch",
    "json merge patch",
    "json pointer",
    "jsonpath",
    "jq query yaml",
    "kubernetes manifest",
    "helm values",
    "github actions yaml",
    "terraform tf",
    "dockerfile lint",
    "package json edit",
    "cargo toml edit",
    "pyproject toml",
    "markdown frontmatter",
    "dotenv edit",
    "ini edit",
    "csv to json",
    "xml pom",
    "round-trip yaml",
    "convert yaml to json",
    "fmt yaml",
    "sarif lint",
    "code scanning lint",
    "junit lint",
    "tap lint",
    "dq cli"
  ],
  "homepage": "https://github.com/mazuninky/dq",
  "repository": "https://github.com/mazuninky/dq",
  "license": "MIT"
}
